<Window x:Class="StudentGroupSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информационная система учебной группы" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl>
            <!-- Вкладка 1: Студенты (добавит Разработчик 1) -->
            <TabItem Header="Студенты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtFullName" Width="200" Margin="0,0,5,0" ToolTip="ФИО"/>
                        <TextBox x:Name="txtGroup" Width="80" Margin="0,0,5,0" ToolTip="Группа"/>
                        <TextBox x:Name="txtPhone" Width="120" Margin="0,0,5,0" ToolTip="Телефон"/>
                        <TextBox x:Name="txtGrade" Width="50" Margin="0,0,5,0" ToolTip="Средний балл"/>
                        <Button Content="Добавить" Width="80" Margin="0,0,5,0" Click="btnAdd_Click"/>
                        <Button Content="Удалить" Width="80" Click="btnRemove_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
              x:Name="dgStudents"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="100"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="Балл" Binding="{Binding AverageGrade}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="lblStatus" Foreground="Red" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Поиск (добавит Разработчик 2) -->
            <TabItem Header="Поиск">
                <Grid>
                    <TextBlock Text="Модуль поиска (в разработке...)" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Отчеты (добавит Разработчик 3) -->
            <TabItem Header="Отчеты">
                <Grid>
                    <TextBlock Text="Модуль отчетов (в разработке...)" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>