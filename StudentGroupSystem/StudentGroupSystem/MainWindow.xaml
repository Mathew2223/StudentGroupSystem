<Window x:Class="StudentGroupSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информационная система учебной группы" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl>
            <!-- Вкладка 1: Студенты (добавит Разработчик 1) -->
            <TabItem Header="Студенты">
                <Grid>
                    <TextBlock Text="Модуль студентов (в разработке...)" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Поиск (добавит Разработчик 2) -->
            <TabItem Header="Поиск">
                <Grid>
                    <TextBlock Text="Модуль поиска (в разработке...)" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Отчеты (добавит Разработчик 3) -->
            <TabItem Header="Отчеты">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Модуль отчетов (в разработке...)" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>