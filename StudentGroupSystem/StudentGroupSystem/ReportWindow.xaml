<Window x:Class="StudentGroupSystem.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт по группе студентов"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TxtReport"
                 Grid.Row="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="8"
                 Background="#FAFAFA"/>

            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
                <Button Content="Сохранить в файл"
                    Width="150" Height="30" Margin="0,0,10,0"
                    Click="BtnSave_Click"/>
                <Button Content="Закрыть"
                    Width="100" Height="30"
                    IsCancel="True"
                    Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>